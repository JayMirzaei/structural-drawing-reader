# Copy to .env and fill in only what you use. Nothing here is needed for the offline quickstart:
# without a provider the reader answers from its rules alone and nothing leaves the machine.
#
# Where they are read: `docker compose` passes this whole file to the container as its environment.
# The Streamlit app reads .env from the repository root before it reads any setting; a variable
# already set in the environment wins. The command line reads only the environment (export the
# variables, or `set -a; . ./.env; set +a`), so a run is reproducible from its command line.
# Comments go on their own lines.

# Which provider answers the questions the rules are unsure about; the app's sidebar starts on it.
# none | local | gemini | openai | anthropic   (default: none)
DRAWING_READER_PROVIDER=

# A local OpenAI-compatible server (llama.cpp llama-server, Ollama). No extra and no key needed.
# llama.cpp default: http://127.0.0.1:8080    Ollama: http://127.0.0.1:11434
# DRAWING_READER_LOCAL_URL=http://127.0.0.1:8080
# The model to ask for. Default: the server's loaded model (llama.cpp) or its first listed one.
# DRAWING_READER_LOCAL_MODEL=
# Characters of facts sent to a small-context model (default 9000, about 3k tokens).
# DRAWING_READER_LOCAL_FACT_BUDGET=9000

# Google Gemini (extra: gemini)
GEMINI_API_KEY=
# DRAWING_READER_GEMINI_MODEL=

# OpenAI (extra: openai)
OPENAI_API_KEY=
# DRAWING_READER_OPENAI_MODEL=

# Anthropic (extra: anthropic)
ANTHROPIC_API_KEY=
# DRAWING_READER_ANTHROPIC_MODEL=
# 1 opts in to the API's server-side refusal fallback (beta); default off.
# DRAWING_READER_ANTHROPIC_FALLBACKS=0

# App only: model calls (attempts, failed ones included) per browser session before it falls back
# to rules (default 40).
# DRAWING_READER_MAX_LLM_CALLS=40

# Where extracted primitives, page images, OCR results and cached answers are kept.
# DRAWING_READER_CACHE=.drawing_reader_cache
